# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB URI (leave blank to use SQLite fallback)
MONGODB_URI=
DATABASE_NAME=corrosion_inspection

# SQLite path (used when MONGODB_URI is empty)
SQLITE_PATH=corrosion.db

# ─── ML Model ────────────────────────────────────────────────────────────────
# Path to local YOLO/ONNX model file (relative to backend/)
# Leave blank to use DEMO mode (no real inference)
MODEL_PATH=models/corrosion.pt

# Roboflow API key (only needed if downloading model from Roboflow)
ROBOFLOW_API_KEY=

# Set to "demo" to force demo mode regardless of model file
INFERENCE_MODE=auto

# ─── File Handling ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ─── Severity Thresholds (prototype — not engineering standards) ──────────────
# Affected area % upper bound for each level
LOW_MAX=5
MODERATE_MAX=20
HIGH_MAX=50
# Above HIGH_MAX → Critical

# ─── Environmental Thresholds ────────────────────────────────────────────────
HUMIDITY_ELEVATED_THRESHOLD=70
TEMP_HIGH_THRESHOLD=35

# ─── Temperature/Humidity Validation ─────────────────────────────────────────
TEMP_MIN=-40
TEMP_MAX=85
HUMIDITY_MIN=0
HUMIDITY_MAX=100

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Gemini AI Solution ──────────────────────────────────────────────────────
# Free Google AI Studio API key (https://aistudio.google.com/app/apikey)
# Leave blank to fall back to deterministic recommendations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
